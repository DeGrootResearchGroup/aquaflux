    ( 1.79 -0.05  0.91)   // 5
    ( 1.79  0.05  0.91)   // 6
    (-0.05  0.05  0.91)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (230 13 120) simpleGrading (1 1 1)
);

edges ();

boundary
(
    boundingBox
    {
        type patch;
        faces
        (
            (0 1 2 3)
            (4 5 6 7)
            (0 3 7 4)
            (1 2 6 5)
            (0 1 5 4)
            (3 2 6 7)
        );
    }
);

